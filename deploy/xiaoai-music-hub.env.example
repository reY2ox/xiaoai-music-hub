# xiaoai-music-hub 环境变量示例
# 用法：复制到 /etc/xiaoai-music-hub.env 并按需修改（systemd 单元通过 EnvironmentFile 读取）。
# 完整说明见 README「配置」一节与 xiaoai_hub/config.py 的 ENV_DOC。

# ---- 网络 ----
# HTTP 监听地址 / 端口
XIAOAI_HOST=0.0.0.0
PORT=8010
# 默认音箱 IP（可在网页里切换设备）
XIAOAI_IP=192.168.3.81
# 媒体 URL 使用的本机局域网 IP。留空自动探测；多网卡 / VPN / 容器部署时强烈建议显式填写。
# LAN_IP=192.168.3.100

# ---- 数据目录 ----
# 数据根目录（db / cache / secrets / music 都在其下），默认仓库根目录
DATA_DIR=/opt/xiaoai-music-hub/data
# 需要时单独覆盖：
# DB_PATH=/opt/xiaoai-music-hub/data/music.db
# MUSIC_DIR=/opt/xiaoai-music-hub/data/music
# CACHE_DIR=/opt/xiaoai-music-hub/data/cache
# SECRETS_DIR=/opt/xiaoai-music-hub/data/secrets
# COOKIE_FILE=/opt/xiaoai-music-hub/data/secrets/netease.cookie
# WEB_DIR=/opt/xiaoai-music-hub/xiaoai_hub/web

# ---- 安全 ----
# 设置后 Web / API 需要 HTTP Basic Auth（用户名任意，密码即此值）；留空不鉴权
# UI_PASSWORD=change-me

# ---- 网易云 ----
# NETEASE_BASE=https://music.163.com
# NETEASE_TIMEOUT=15
# NETEASE_ACCOUNT_TTL=60

# ---- 下载 ----
# DOWNLOAD_CONCURRENCY=2
# DOWNLOAD_MAX_RETRY=2
# DOWNLOAD_TIMEOUT=120

# ---- 播放监测 ----
# AUTO_ADVANCE_INTERVAL=1.5
# AUTO_ADVANCE_FRESH=120
# END_TOLERANCE=8
# 设备不返回时长时是否兜底续播；默认 0，开启后语音暂停可能被误判为播完
# AUTO_ADVANCE_UNKNOWN_DURATION=0

# ---- 免打扰 ----
# QUIET_HOURS=23:30-08:00

# ---- 其它 ----
# CACHE_MAX_MB=2048
# LOG_LEVEL=INFO
# LOG_FILE=/opt/xiaoai-music-hub/data/hub.log
